# ---------------------------------------------------------------------------
# Instagram side (requires an Instagram BUSINESS or CREATOR account)
# ---------------------------------------------------------------------------
# App secret from developers.facebook.com -> App settings -> Basic.
# Used to verify X-Hub-Signature-256 on every webhook delivery.
IG_APP_SECRET=

# Any random string you also type into the Meta webhook config screen.
IG_VERIFY_TOKEN=change-me-to-something-random

# Long-lived Page/Instagram access token with instagram_business_manage_messages
# (plus pages_manage_metadata so webhooks stay subscribed).
IG_ACCESS_TOKEN=

# The Instagram professional account's user id (the "entry.id" in webhooks).
IG_USER_ID=

# Graph host. Use https://graph.facebook.com/v23.0 for "Instagram API with
# Facebook Login", or https://graph.instagram.com/v23.0 for
# "Instagram API with Instagram Login".
IG_GRAPH_BASE=https://graph.facebook.com/v23.0

# ---------------------------------------------------------------------------
# Google Chat side (requires a Google WORKSPACE account, not @gmail.com)
# ---------------------------------------------------------------------------
# Space that receives every Instagram DM. Threads are created per IG conversation.
GOOGLE_CHAT_SPACE=spaces/AAAAAAAAAAA

# Service account JSON used to call the Chat API (chat.bot scope).
# Either a path on disk or the raw JSON.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Your Google Cloud project number. Used to verify the JWT Google attaches to
# every request it makes to your Chat app endpoint.
GOOGLE_CHAT_PROJECT_NUMBER=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
PORT=8080
STORE_PATH=./data/store.json

# Instagram only lets you reply within 24h of the user's last DM. Set this to
# true to fall back to the HUMAN_AGENT tag (extends to 7 days, support use
# only, audited by Meta) instead of refusing to send.
ALLOW_HUMAN_AGENT_TAG=false

# Prefix messages going to Instagram with the Google Chat sender's name.
PREFIX_CHAT_SENDER=true
